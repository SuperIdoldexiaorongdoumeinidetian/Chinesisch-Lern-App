# Vorlage für die Supabase-Konfiguration.
# Kopiere diese Datei zu ".env" und trage deine eigenen Werte ein
# (Supabase-Dashboard → Settings → API).
VITE_SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=dein-publishable-oder-anon-key

# KI-Grammatikübungen ("Modus B") über den Serverless-Proxy (api/grammar.js).
# Diese Variablen werden NUR serverseitig (Vercel Function) gelesen – kein
# VITE_-Präfix, damit der geheime Key niemals ins Client-Bundle gelangt.
# Auf Vercel als Environment Variables im Projekt hinterlegen (nicht committen!).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Modell überschreiben (Standard: claude-opus-4-8).
# GRAMMAR_MODEL=claude-opus-4-8
